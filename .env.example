# ============================================================
# mini-agent-lab 环境变量模板
#
# 用法（复制一份，再填你自己的 Key）：
#   PowerShell : Copy-Item .env.example .env
#   CMD        : copy .env.example .env
#   Git Bash   : cp .env.example .env
#
# 注意：.env 已被 .gitignore 排除，永远不会被提交到版本库。
#
# Phase 0 阶段的程序完全不需要读这些值，这里只是提前占位。
# 从 Phase 1 开始程序才会真正读取。
# ============================================================

# 模型服务的 API Key。没有 Key 就没有「判断」，也就没有 Agent。
OPENAI_API_KEY=sk-your-key-here

# API 地址。同一套代码可以指向完全不同的服务商，只改这一行。
#   OpenAI     : https://api.openai.com/v1
#   DeepSeek   : https://api.deepseek.com/v1
#   GLM 智谱   : https://open.bigmodel.cn/api/paas/v4
#   Kimi       : https://api.moonshot.cn/v1
#   OpenRouter : https://openrouter.ai/api/v1
#   本地 Ollama: http://localhost:11434/v1
#   本地 mock  : http://127.0.0.1:8765/v1   （见下，不需要 Key）
OPENAI_BASE_URL=https://api.openai.com/v1

# 用哪个模型，需要和你选的 OPENAI_BASE_URL 匹配
OPENAI_MODEL=gpt-4o-mini

# ============================================================
# 没有 Key 也可以先验证接线：跑一个本地假服务器
#
#   新开一个终端：  python tests/mock_server.py
#   本文件改成：
#       OPENAI_API_KEY=any-value
#       OPENAI_BASE_URL=http://127.0.0.1:8765/v1
#       OPENAI_MODEL=mock-model
#
# 能回话就说明「读配置 → 发请求 → 解析响应」整条链路通了，
# 这样等你填真 Key 出问题时，就只剩服务商那边的原因了。
# ============================================================

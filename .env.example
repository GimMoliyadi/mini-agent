# 复制到 .env 或运行 .\mini.cmd config。不要提交真实密钥。
# 使用支持 Chat Completions 和 Tool Calling 的 OpenAI-compatible 服务。
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.example.com/v1
OPENAI_MODEL=your-tool-calling-model

# ASK：写入/执行前审批；ALLOW：明确允许；DENY：只读。
TOOL_APPROVAL_MODE=ASK

# 完整会话保存在本地 Checkpoint；以下只限制模型实际收到的上下文。
MINI_AGENT_MAX_MODEL_CALLS=20
MINI_AGENT_CONTEXT_TOKENS=16000
MINI_AGENT_REQUEST_TIMEOUT=120

# 可选事件日志，仅写入事件元数据；建议选择工作区之外的路径。
MINI_AGENT_TRACE_JSONL=

# 可选资源预算，超过预算会显式停止，Checkpoint 可用于恢复。
MINI_AGENT_MAX_TOOL_CALLS=100
MINI_AGENT_MAX_TOTAL_TOKENS=200000
MINI_AGENT_TASK_TIMEOUT_SECONDS=600

# HTTP_PROXY / HTTPS_PROXY / ALL_PROXY / NO_PROXY 由进程环境控制。
# 例如 PowerShell：$env:HTTPS_PROXY="http://127.0.0.1:7897"
# 本地服务：$env:NO_PROXY="127.0.0.1,localhost"
